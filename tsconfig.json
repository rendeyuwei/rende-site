{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleDetection": "auto",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "src",
    "removeComments": true,
    "sourceMap": false,
    "newLine": "lf"
  },
  "include": ["src/**/*.ts"]
}
